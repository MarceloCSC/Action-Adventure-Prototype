# ============================================================
# Unity - Standard .gitignore
# Based on github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================

# Unity generated directories
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated logs and temporary files
*.log
*.tmp
mono_crash.*
sysinfo.txt

# Blender backup files
*.blend1
*.blend1.meta

# IDEs and development tools
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.DotSettings.user

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Generated IDE projects and solutions
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build outputs and exported packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# Unity Addressables generated files
/ServerData/
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Unity Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers*

# Unity Test Runner
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Unity UI Toolkit generated files
/UIElementsSchema/

# Unity scene dependency cache
/[Aa]ssets/[Ss]ceneDependencyCache*

# Legacy Unity Version Control (Plastic SCM)
/.plastic/
/ignore.conf

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini